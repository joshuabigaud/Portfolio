{
  "name": "joshua-bigaud-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Joshua Bigaud — independent designer and developer. A static portfolio with an interactive 3D avatar.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/build.mjs --demo",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "preview:demo": "node scripts/build.mjs --demo && node scripts/serve.mjs --root .preview/demo --port 4174",
    "check": "node scripts/check.mjs",
    "check:rig": "node scripts/check-avatar-rig.mjs",
    "check:demo": "node scripts/check.mjs --demo",
    "test": "node --test scripts/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "0.180.0"
  }
}
